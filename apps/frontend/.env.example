# API consumed by the Next.js app in the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Standalone Signa marketing, documentation, and journal origin.
NEXT_PUBLIC_MARKETING_URL=http://localhost:3002

# Optional. Use your LAN URL in development so QR signing opens on a phone.
# Example: http://192.168.1.20:3000
NEXT_PUBLIC_SIGNING_BASE_URL=

# Google Drive Picker import. Configure these from Google Cloud Console.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_PICKER_APP_ID=

# Optional. Set to "export" only if intentionally building a static export.
NEXT_OUTPUT=
