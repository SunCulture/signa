<!doctype html>
<html lang="{{locale}}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="x-apple-disable-message-reformatting">
    <title>SMTP configured</title>
  </head>
  <body style="margin:0; padding:0; background:#eef4f8; color:#173457; font-family:Arial, Helvetica, sans-serif;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#eef4f8;">
      <tr>
        <td align="center" style="padding:32px 12px;">
          <table role="presentation" width="560" cellspacing="0" cellpadding="0" border="0" style="width:560px; max-width:100%; background:#ffffff; border-radius:22px; box-shadow:0 18px 42px rgba(23,52,87,0.14);">
            <tr>
              <td align="center" style="padding:34px 24px 8px;">
                <img src="{{logoUrl}}" width="132" alt="Signa" style="display:block; width:132px; max-width:132px; height:auto; border:0;">
              </td>
            </tr>
            <tr>
              <td style="padding:22px 34px 38px;">
                <h1 style="margin:0 0 18px; color:#0d1f36; font-size:32px; line-height:38px; font-weight:800;">SMTP is ready</h1>
                <p style="margin:0; color:#50657b; font-size:17px; line-height:28px;">SMTP has been successfully configured for Signa.</p>
              </td>
            </tr>
          </table>
          <p style="margin:22px 0 0; color:#8b9caf; font-size:13px; line-height:20px;">Sent securely with Signa</p>
        </td>
      </tr>
    </table>
  </body>
</html>
